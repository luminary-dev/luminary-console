{
  "name": "luminary-console",
  "version": "1.1.0",
  "private": true,
  "description": "Luminary studio console — AI-drafted client documents (estimate, questionnaire, quotation, proposal, contract, invoice, receipt) on per-client subdomains, end to end",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "r2:init": "tsx scripts/r2-init.ts",
    "recreate:ecomech": "tsx scripts/recreate-ecomech.ts",
    "test:live:article": "tsx --env-file=.env.local scripts/tests/suite-article.ts",
    "test:live:project": "tsx --env-file=.env.local scripts/tests/suite-project.ts",
    "test:live:client": "tsx --env-file=.env.local scripts/tests/suite-client.ts",
    "test:live:ops": "tsx --env-file=.env.local scripts/tests/suite-ops.ts",
    "test:live:notify": "tsx --env-file=.env.local scripts/tests/suite-notify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@octokit/webhooks-methods": "6.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "next": "16.3.0",
    "puppeteer-core": "^25.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
