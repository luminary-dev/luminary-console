{
  "name": "luminary-console",
  "version": "1.1.0",
  "private": true,
  "description": "Luminary studio console — AI-drafted client documents (estimate, questionnaire, quotation, proposal, contract, invoice, receipt) on per-client subdomains, end to end",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "r2:init": "tsx scripts/r2-init.ts",
    "recreate:ecomech": "tsx scripts/recreate-ecomech.ts",
    "test:live:article": "tsx --env-file=.env.local scripts/tests/suite-article.ts",
    "test:live:project": "tsx --env-file=.env.local scripts/tests/suite-project.ts",
    "test:live:client": "tsx --env-file=.env.local scripts/tests/suite-client.ts",
    "test:live:ops": "tsx --env-file=.env.local scripts/tests/suite-ops.ts",
    "test:live:notify": "tsx --env-file=.env.local scripts/tests/suite-notify.ts",
    "ix": "dotenv run -q -f .env.local -- playwright test",
    "ix:viewport": "dotenv run -q -f .env.local -- playwright test --project=w320 --project=w360 --project=w390 --project=w430 --project=w768 --project=w834 --project=w1024 --project=w1280 --project=w1440 --project=w1920 --project=w2560 --project=w3440 --project=landscape-640x360",
    "ix:a11y": "dotenv run -q -f .env.local -- playwright test --project=axe",
    "ix:touch": "dotenv run -q -f .env.local -- playwright test --project=touch",
    "ix:keyboard": "dotenv run -q -f .env.local -- playwright test --project=keyboard",
    "ix:perf": "dotenv run -q -f .env.local -- playwright test --project=perf",
    "ix:inventory": "playwright test --project=inventory"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@octokit/webhooks-methods": "6.0.0",
    "@sparticuz/chromium": "^153.0.0",
    "next": "16.4.2",
    "puppeteer-core": "^25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.33.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "^18.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
