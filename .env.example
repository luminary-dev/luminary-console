# Luminary Console — environment template (AUDIT.md OPS-11)
#
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# Values below are placeholders/examples only — no real secrets belong here.
# Platform-injected vars (NODE_ENV, VERCEL) and per-run ops vars (OPS_ACTOR,
# OPS_REQUEST_ID) are set by Vercel / the ops runner and are not listed here.

# ——— Console auth ———
# Comma-separated operator allowlist; each entry is
#   email:scrypt$N$r$p$saltB64url$hashB64url   (see lib/users.ts to generate)
CONSOLE_USERS=
# HMAC key for the signed session cookie. Use a long random string.
SESSION_SECRET=

# ——— AI drafting ———
ANTHROPIC_API_KEY=
# Only needed for the Publish portal's cover/illustration art.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# ——— Email (Resend) ———
RESEND_API_KEY=
SENDER=Luminary <hello@luminary-dev.xyz>
STUDIO_EMAIL=support@luminary-dev.xyz

# ——— Storage (Cloudflare R2 via the S3 API; private bucket) ———
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ——— DNS automation (Cloudflare) ———
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ——— Domain attach (Vercel) ———
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ——— Hosts ———
ROOT_DOMAIN=luminary-dev.xyz
CONSOLE_HOST=console.luminary-dev.xyz

# ——— Web Push (installed PWA); generate with `web-push generate-vapid-keys` ———
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@luminary-dev.xyz

# ——— GitHub App (preferred) — see docs/GITHUB-APP.md ———
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Webhook HMAC secret. Without it the webhook endpoint refuses every delivery.
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=luminary-dev
# email:login pairs, comma-separated (for "needs my review" + notification rules)
GITHUB_OPERATORS=
# Optional per-operator quiet hours, e.g. dhanikaa:22-8
GITHUB_QUIET_HOURS=
GITHUB_QUIET_TZ=Asia/Colombo
# Read-only fallback when the App is not configured (REST only, no webhooks).
GH_TOKEN=

# ——— Cron auth ———
# Bearer the Vercel Cron requests must carry; the cron routes fail closed
# without it. Use a long random string.
CRON_SECRET=

# ——— Ops-via-Actions (optional; the console UI executes mutations on Actions) ———
OPS_VIA_ACTIONS=
# Fine-grained PAT on this repo with Actions: write.
CONSOLE_REPO_TOKEN=
CONSOLE_REPO=luminary-dev/luminary-console
# Landing-page Publish portal.
LANDING_REPO=luminary-dev/luminary
LANDING_REPO_TOKEN=

# ——— Telegram studio notifications ———
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ——— PDF rendering (optional local hints) ———
# Path to a Chrome/Chromium binary when the bundled one isn't used.
CHROME_PATH=
CHROME_BIN=
